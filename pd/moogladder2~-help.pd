#N canvas 80 40 1000 610 12;
#X obj 20 15 moogladder2~;
#X text 128 15 - Moog ladder lowpass \, faster version;
#X text 20 45 moogladder~ with a fast tanh approximation \, and a negative resonance clamped to 0., f 105;
#X text 20 130 sawtooth 110 Hz;
#X obj 20 155 tgl 18 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000 0 1;
#X text 45 155 on;
#X obj 20 185 phasor~ 110;
#X obj 20 215 -~ 0.5;
#X obj 20 245 *~ 0;
#X obj 760 130 loadbang;
#X floatatom 330 130 6 0 0 0 - - - 0;
#X text 390 130 cutoff: Hz, f 45;
#X msg 330 155 \$1 20;
#X obj 385 155 line~;
#X msg 760 155 1000;
#X msg 440 155 200;
#X msg 500 155 1000;
#X msg 560 155 4000;
#X floatatom 330 190 6 0 0 0 - - - 0;
#X text 390 190 resonance: usually below 1, f 45;
#X msg 330 215 \$1 20;
#X obj 385 215 line~;
#X msg 760 215 0.5;
#X msg 440 215 0;
#X msg 500 215 0.7;
#X msg 560 215 1;
#X msg 330 250 100 \, 8000 4000;
#X text 460 250 sweep the cutoff;
#X msg 330 290 clear;
#X obj 20 340 moogladder2~;
#X obj 20 450 *~ 1;
#X text 100 450 gain;
#X obj 20 485 *~ 0.2;
#X floatatom 90 485 5 0 0 0 - - - 0;
#X text 140 485 volume;
#X obj 20 520 dac~ 1 2;
#X msg 20 555  \; pd dsp 1;
#X msg 110 555  \; pd dsp 0;
#X text 200 560 DSP on / off;
#N canvas 200 100 800 700 reference 0;
#X text 20 10 moogladder2~ [cutoff] [resonance], f 90;
#X text 20 32 Arguments: cutoff (default 1000) \, resonance (default 0.5)., f 90;
#X text 20 76 INLETS, f 90;
#X text 20 98 1: input (signal) and messages, f 90;
#X text 20 120 2: cutoff (signal/float) \, Hz, f 90;
#X text 20 142 3: resonance (signal/float) \, usually below 1, f 90;
#X text 20 186 OUTLETS, f 90;
#X text 20 208 1: output (signal), f 90;
#X text 20 252 MESSAGES, f 90;
#X text 20 274 clear: reset the filter state (Csound's istor/iskip = 0), f 90;
#X text 20 318 NOTES, f 90;
#X text 20 340 Csound opcode: moogladder2. Credits: Victor Lazzarini and Gleb Rogozinsky (newfils.c). LGPL 2.1., f 90;
#X text 20 388 Tested against Csound 6.18 (tests/vafilters_check.c)., f 90;
#X restore 330 390 pd reference;
