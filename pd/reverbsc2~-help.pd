#N canvas 40 30 1050 750 12;
#X obj 20 15 reverbsc2~;
#X text 112 15 - stereo reverb \, Csound 7's lighter version (linear interpolation);
#X text 20 45 Eight delay lines feed each other through a scattering junction (Julius O. Smith's waveguide networks) \; their lengths wander slowly at random \, so the tail is smooth and never metallic. The Csound reverb everybody uses., f 110;
#N canvas 200 100 800 568 reference 0;
#X text 20 10 reverbsc2~ [feedback] [lpfreq] [pitchmod], f 100;
#X text 20 32 Defaults: feedback 0.85 \, lowpass 10000 Hz \, pitch modulation 1., f 100;
#X text 20 76 INLETS, f 100;
#X text 20 98 1 \, 2: (signal) left and right input \; messages, f 100;
#X text 20 120 3: (signal/float) feedback 0..1: the length of the tail (0.6 room \, 0.85 hall \, 0.95 cathedral), f 100;
#X text 20 142 4: (signal/float) cutoff of the lowpass in the loop \, Hz: darker tails with lower values, f 100;
#X text 20 186 OUTLETS, f 100;
#X text 20 208 1 \, 2: (signal) left and right reverberation (no dry signal), f 100;
#X text 20 252 MESSAGES, f 100;
#X text 20 274 pitchmod <f>: depth of the random delay changes \, 0..20 (1): 0 is static and can ring \, higher is a chorus (rebuilds \, silent), f 100;
#X text 20 322 clear: silence the tail, f 100;
#X text 20 366 NOTES, f 100;
#X text 20 388 Csound opcodes: reverbsc \, reverbsc2 (Csound 7: linear interpolation of the delays \, lighter). reverbsc~ output matches Csound 6.18 within 8e-9., f 100;
#X text 20 436 Feedback and cutoff are read once per block \, as Csound's k-rate arguments. Port: the feedback is kept below 1 \, input NaN become 0. Csound's isr argument (the rate the delay times are computed for) is the host sample rate here., f 100;
#X text 20 506 Copyright 1999 \, 2005 Sean Costello and Istvan Varga \, LGPL 2.1., f 100;
#X restore 20 100 pd reference;
