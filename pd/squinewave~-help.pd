#N canvas 40 30 1050 750 12;
#X obj 20 15 squinewave~;
#X text 120 15 - sine \, square \, saw and pulse from one morphing oscillator;
#X text 20 45 A cosine whose sweeps get shorter: clip squeezes both halves (sine to square) \, skew moves the middle (towards saw and narrow pulses). The sweeps are never shorter than a few samples \, so the edges stay band limited without tables. Hard sync and through zero FM included., f 110;
#N canvas 200 100 800 538 reference 0;
#X text 20 10 squinewave~ [freq] [clip] [skew] [minsweep] [phase], f 100;
#X text 20 32 Defaults: 220 Hz \, clip 0 \, skew 0 \, minsweep sr/3000 (at least 8) \, phase at the up zero crossing., f 100;
#X text 20 76 INLETS, f 100;
#X text 20 98 1: (signal/float) frequency in Hz \; negative runs the wave backwards (through zero FM) \; messages, f 100;
#X text 20 120 2: (signal/float) clip 0..1: 0 sine-like \, 1 square-like, f 100;
#X text 20 142 3: (signal/float) skew -1..1: 0 symmetric \, towards +-1 a saw or a narrow pulse, f 100;
#X text 20 164 4: (signal) sync: a sample >= 1 starts a new cycle (hard sync), f 100;
#X text 20 208 OUTLETS, f 100;
#X text 20 230 1: (signal) the wave -1..1, f 100;
#X text 20 252 2: (signal) 1 at the start of each cycle: sync another squinewave~, f 100;
#X text 20 296 MESSAGES, f 100;
#X text 20 318 phase <0..2>: restart at this phase (negative: the up zero crossing), f 100;
#X text 20 340 minsweep <n>: shortest sweep in samples \, 4..sr/100: higher is rounder and less aliased, f 100;
#X text 20 384 NOTES, f 100;
#X text 20 406 Csound opcode: squinewave (the Csound 7 version: fractional minsweep \, sharper sync \, through zero FM). Output matches Csound 6.18 within 3e-8 with positive frequencies., f 100;
#X text 20 454 Above sr/(2 minsweep) the wave becomes a pure sine., f 100;
#X text 20 476 Copyright 2017 \, 2024 rasmus ekman \, LGPL 2.1., f 100;
#X restore 20 100 pd reference;
#X text 20 140 1. Shape: clip and skew;
#X floatatom 20 165 6 0 0 0 - - - 0;
#X floatatom 120 165 5 0 0 0 - - - 0;
#X floatatom 220 165 5 0 0 0 - - - 0;
#X text 20 190 freq;
#X text 120 190 clip;
#X text 220 190 skew;
#X obj 350 330 unpack f f;
#X msg 350 165 0 0;
#X text 420 165 sine;
#X msg 350 190 1 0;
#X text 420 190 square;
#X msg 350 215 0 1;
#X text 420 215 saw-like (skewed sine);
#X msg 350 240 1 0.9;
#X text 420 240 narrow pulse;
#X msg 350 265 0.5 -0.6;
#X text 420 265 in between;
#X msg 350 290 0 -1;
#X text 420 290 saw down;
#X msg 20 220 55;
#X msg 75 220 110;
#X msg 130 220 440;
#X msg 185 220 1760;
#X obj 20 250 loadbang;
#X msg 20 275 110;
#X obj 20 305 tgl 18 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000 0 1;
#X text 45 305 slow sweep of clip and skew (LFO);
#X obj 20 330 osc~ 0.1;
#X obj 120 330 osc~ 0.07;
#X obj 20 355 abs~;
#X obj 20 380 *~ 0;
#X obj 120 380 *~ 0;
#X obj 20 430 squinewave~ 110;
#X msg 250 430 minsweep 4;
#X msg 350 430 minsweep 15;
#X msg 450 430 minsweep 60;
#X text 600 140 2. Hard sync: a slave restarted by the cycles of a master;
#X floatatom 600 165 6 0 0 0 - - - 0;
#X text 655 165 master Hz;
#X floatatom 750 165 6 0 0 0 - - - 0;
#X text 805 165 slave Hz: sweep it;
#X obj 930 195 loadbang;
#X msg 930 220 55;
#X msg 980 220 180;
#X obj 600 200 squinewave~ 55;
#X obj 750 240 squinewave~ 180 0.3 0.5;
#X text 600 275 3. Through zero FM: the frequency goes negative;
#X floatatom 600 300 6 0 0 0 - - - 0;
#X text 655 300 FM depth Hz (try 300);
#X obj 600 325 osc~ 73;
#X obj 600 350 *~;
#X obj 600 375 +~ 110;
#X obj 600 400 squinewave~ 110 0.2 0.3;
